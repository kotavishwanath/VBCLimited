# SMTP settings used by the contact / application forms (Google Workspace / Gmail).
# If SMTP_HOST is empty in development, submissions are logged to the console instead.
#
# SMTP_PASS must be a Google *App Password* (not your normal password):
#   1. Turn on 2-Step Verification for the SMTP_USER account.
#   2. Visit https://myaccount.google.com/apppasswords and create one named "Website".
#   3. Paste the 16-character code below (spaces optional).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jobs@vbclimited.com
SMTP_PASS=

# Gmail only sends as SMTP_USER or a verified "Send mail as" alias.
MAIL_FROM="VBC Limited Website <jobs@vbclimited.com>"
MAIL_TO=jobs@vbclimited.com
MAIL_CC=kvishwanath0551@gmail.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
