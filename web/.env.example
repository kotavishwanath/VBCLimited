# Email for the contact / application forms is sent through Resend (https://resend.com) over SMTP.
# If SMTP_PASS is empty in development, submissions are logged to the terminal instead of emailed.
#
# SMTP_PASS is a Resend API key (starts with "re_"):
#   Resend → API keys → Create API key → Permission "Sending access", Domain "vbclimited.com".
#   Production uses its own key stored in Vercel; ask the project owner rather than reusing it locally.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=

# Sender must be an address on the verified Resend domain (vbclimited.com).
MAIL_FROM="VBC Limited Website <website@vbclimited.com>"
MAIL_TO=jobs@vbclimited.com
MAIL_CC=kvishwanath0551@gmail.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
